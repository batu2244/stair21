{
  "name": "HubSnapshot",
  "type": "object",
  "description": "Immutable archive of each approved version (books and records)",
  "properties": {
    "hub_id": { "type": "string" },
    "version": { "type": "integer" },
    "content": { "type": "object", "description": "Everything the client sees, exactly as approved" },
    "compliance_flags": { "type": "array", "items": { "type": "string" } },
    "advisor_name": { "type": "string" },
    "approved_by": { "type": "string", "description": "Name of the reviewer who signed off" },
    "approved_at": { "type": "string", "format": "date-time" }
  },
  "required": ["hub_id", "version", "content"],
  // No direct browser access. Reads and writes go through the hubs function
  // (scoped by the browser's owner key) and the client-hub function (link token).
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}
